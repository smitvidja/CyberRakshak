# CyberRakshak frontend configuration.
# Copy to .env.local for local development. .env.local is gitignored.

# REQUIRED. Base URL of the backend API, with no trailing slash and no /api/v1
# suffix (the client appends that itself). The app throws on startup if this is
# missing rather than silently falling back to a wrong host.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at BUILD time, not
# read at runtime - so after changing this you must rebuild/redeploy the frontend,
# not just restart it. Put nothing secret in a NEXT_PUBLIC_ variable.
#
# Local:      http://localhost:8000
# Deployed:   https://your-backend.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000
