# CyberRakshak backend configuration.
# Copy to .env for local development. Never commit a real .env - it is gitignored.
#
# Every variable below is read by app/core/config.py. Anything not listed here is
# ignored by the application.

# --- Application ---------------------------------------------------------------
APP_NAME=CyberRakshak API
# Use "production" when deployed. Only affects labelling/logging, not behaviour.
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Security ------------------------------------------------------------------
# REQUIRED. Must be at least 32 characters or the app refuses to start.
# Generate a real one for any deployed environment, never reuse this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-development-secret-at-least-32-characters
JWT_ALGORITHM=HS256
# 43200 = 30 days. No refresh-token flow exists, so this IS the session length - keep it long
# so users stay logged in until they explicitly log out, not until the token happens to expire.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Database ------------------------------------------------------------------
# REQUIRED. PostgreSQL only - the app uses PostgreSQL-specific types and will not
# run on SQLite. Managed providers usually hand you a postgresql:// URL; this app
# needs the psycopg driver, so rewrite the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://cyberrakshak:cyberrakshak_local_only@localhost:5432/cyberrakshak

# --- CORS ----------------------------------------------------------------------
# Origins allowed to call this API from a browser. The API sends credentials, so a
# wildcard "*" is not permitted and is never the default.
# Accepts either a JSON array or a plain comma-separated list - use whichever your
# hosting dashboard makes easier. Both of these are valid:
#   CORS_ORIGINS=["https://your-frontend.example.com"]
#   CORS_ORIGINS=https://your-frontend.example.com,https://www.your-frontend.example.com
# Set this to the deployed frontend URL in production. No trailing slash.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Evidence / resume file storage --------------------------------------------
# Files are written to this path on the local filesystem. See the storage note in
# README.md: on ephemeral hosting this directory does not survive a restart or a
# redeploy, so uploaded evidence is lost. Attach a persistent volume, or accept the
# limitation for a short-lived demo.
LOCAL_STORAGE_PATH=storage
# Maximum accepted upload size in bytes (10 MiB).
EVIDENCE_MAX_FILE_SIZE=10485760

# --- Cyber Saathi LLM gateway -------------------------------------------------
# Provider order, models, and tuning are configuration—not business logic.
LLM_ENABLED=true
LLM_PRIMARY_PROVIDER=gemini
LLM_SECONDARY_PROVIDER=grok
LLM_TERTIARY_PROVIDER=nvidia

# Keep real keys only in backend/.env or the deployment secret manager.
# Gemini AI Studio needs the key value only; the key label/project number are not used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
# The NVIDIA adapter remains available but is skipped safely while this is blank.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_PROVIDER_TIMEOUT_SECONDS=6
LLM_TOTAL_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_MAX_INPUT_TOKENS=3000
LLM_MAX_OUTPUT_TOKENS=600
LLM_SAFETY_TEMPERATURE=0.1
LLM_EXPLANATION_TEMPERATURE=0.25
LLM_CONVERSATION_TEMPERATURE=0.4
LLM_TOP_P=0.9

# --- Cyber Saathi voice -------------------------------------------------------
# Sarvam credentials stay server-side. Voice degrades to the existing text UI
# when disabled or unconfigured.
VOICE_ENABLED=true
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_REALTIME_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
VOICE_PROVIDER_TIMEOUT_SECONDS=12
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_RECORDING_SECONDS=60
