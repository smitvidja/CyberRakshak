APP_NAME=CyberRakshak API
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://cyberrakshak:cyberrakshak_local_only@localhost:5432/cyberrakshak
SECRET_KEY=replace-with-a-long-random-development-secret
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-object-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-local-object-storage-secret-key
OBJECT_STORAGE_BUCKET=cyberrakshak-local
AI_API_KEY=replace-with-provider-key-when-enabled