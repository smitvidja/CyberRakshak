# CyberRakshak backend configuration.
# Copy to .env for local development. Never commit a real .env - it is gitignored.
#
# Every variable below is read by app/core/config.py. Anything not listed here is
# ignored by the application.

# --- Application ---------------------------------------------------------------
APP_NAME=CyberRakshak API
# Use "production" when deployed. Only affects labelling/logging, not behaviour.
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Security ------------------------------------------------------------------
# REQUIRED. Must be at least 32 characters or the app refuses to start.
# Generate a real one for any deployed environment, never reuse this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-development-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ------------------------------------------------------------------
# REQUIRED. PostgreSQL only - the app uses PostgreSQL-specific types and will not
# run on SQLite. Managed providers usually hand you a postgresql:// URL; this app
# needs the psycopg driver, so rewrite the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://cyberrakshak:cyberrakshak_local_only@localhost:5432/cyberrakshak

# --- CORS ----------------------------------------------------------------------
# Origins allowed to call this API from a browser. The API sends credentials, so a
# wildcard "*" is not permitted and is never the default.
# Accepts either a JSON array or a plain comma-separated list - use whichever your
# hosting dashboard makes easier. Both of these are valid:
#   CORS_ORIGINS=["https://your-frontend.example.com"]
#   CORS_ORIGINS=https://your-frontend.example.com,https://www.your-frontend.example.com
# Set this to the deployed frontend URL in production. No trailing slash.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Evidence / resume file storage --------------------------------------------
# Files are written to this path on the local filesystem. See the storage note in
# README.md: on ephemeral hosting this directory does not survive a restart or a
# redeploy, so uploaded evidence is lost. Attach a persistent volume, or accept the
# limitation for a short-lived demo.
LOCAL_STORAGE_PATH=storage
# Maximum accepted upload size in bytes (10 MiB).
EVIDENCE_MAX_FILE_SIZE=10485760
