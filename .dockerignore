# Build context for backend/Dockerfile is the repository root, so everything the
# backend image does not need is excluded here. Only backend/ and database/ are copied.

.git
.gitignore
.agents/

# The frontend has its own build context and .dockerignore.
frontend/

# Python environments, caches, and test artefacts
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/

# Dev-only code: tests and one-off asset/demo scripts have no place in the runtime image.
backend/tests/
backend/scripts/

# Secrets never enter an image layer
**/.env
**/.env.*
!**/.env.example

# Local runtime data
backend/storage/
backend/uploads/
postgres_data/

# Documentation, design sources, and demo material
docs/
design/
prompts/
demo-assets/
*.md
docker-compose.yml
render.yaml
skills-lock.json
