# Build context for backend/Dockerfile is the repository root, so everything the
# backend image does not need is excluded here. Only backend/ and database/ are copied.

.git
.gitignore
.agents/

# The frontend has its own build context and .dockerignore.
frontend/

# Python environments, caches, and test artefacts
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/

# Dev-only code: tests and one-off asset/demo scripts have no place in the runtime image.
backend/tests/
backend/scripts/
# ...except the retention purge, which docker-entrypoint.sh runs on every start.
# Excluding the whole directory meant `python -m scripts.purge_expired_conversations`
# raised ModuleNotFoundError in every container, and the entrypoint swallows that
# failure by design - so expired Cyber Saathi conversations were never deleted, and
# nothing said so. A citizen is told their conversation is kept for thirty days.
!backend/scripts/__init__.py
!backend/scripts/purge_expired_conversations.py

# Secrets never enter an image layer
**/.env
**/.env.*
!**/.env.example

# Local runtime data
backend/storage/
backend/uploads/
postgres_data/

# Documentation, design sources, and demo material
docs/
design/
prompts/
demo-assets/
*.md
docker-compose.yml
render.yaml
skills-lock.json
