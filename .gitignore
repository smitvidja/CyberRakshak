# Patterns without a leading "/" apply in every folder, so a new package or
# service is covered without editing this file.

# --- Secrets -----------------------------------------------------------------
# Every .env variant (.env.production, .env.staging, ...) is ignored; only the
# documented example files are committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Dependencies and build output -------------------------------------------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
frontend/.voice-test-build/

# --- Python environments, caches, and test output ----------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local runtime data and uploaded artifacts -------------------------------
postgres_data/
uploads/
storage/
dataset-CyberSathi/
knowledge-sources/

# --- Scratch space, logs, and tool state -------------------------------------
.tmp/
tmp/
.codex-runtime/
*.log
.claude/settings.local.json

# --- Editor and operating-system files ---------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Large or regenerated design material ------------------------------------
# Raw awareness-poster source art (~21MB of PNGs + a duplicate PDF) - not needed at
# runtime. The optimized WebP outputs and the real PDF live in frontend/public/ and
# ARE committed; these are only the source backend/scripts/prepare_awareness_assets.py
# reads from. Re-run that script after replacing anything in here.
demo-assets/Resources/

# Screenshot output from design review runs - regenerated on demand, 25 MB and
# growing, and never source.
design/previews/
